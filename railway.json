{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build",
    "env": {
      "NODE_ENV": "development",
      "NPM_CONFIG_PRODUCTION": "false"
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "env": {
      "NODE_ENV": "production"
    },
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
