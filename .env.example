# Hoflings backend configuration.
# Copy to .env.local for local development, or set the same names as
# environment variables on the host (Cloudflare Pages / Railway).
# Never commit real values — .env* is git-ignored except this file.

# --- Supabase (auth + contacts storage) ---
SUPABASE_URL=https://wepbxrgugqctotczeamu.supabase.co
# Legacy "anon" JWT — safe to use in a browser, bypasses nothing.
SUPABASE_ANON_KEY=
# Legacy "service_role" JWT — server-side only, bypasses RLS. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- SendGrid (contact notifications + visitor auto-reply) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@hoflings.com
SENDGRID_FROM_NAME=Hoflings

# --- Addresses ---
# The only address allowed to sign in to /auth or create an account.
# May be a comma-separated allow-list, e.g. you@gmail.com,alias@gmail.com
# — every listed address needs its own confirmed account in Supabase Auth.
ADMIN_EMAIL=egodberg1782@gmail.com,egoldberg1782@gmail.com
# Where new-contact notifications are delivered. Comma-separated for several
# recipients; falls back to ADMIN_EMAIL when empty.
CONTACT_TO_EMAIL=egodberg1782@gmail.com
# Reply-to on the visitor auto-reply.
CONTACT_REPLY_TO=support@hoflings.com
# Public origin of the site, used for password-reset redirects.
PUBLIC_SITE_URL=https://hoflings.com
